{
  "owner": "JuanenRac",
  "ecosystems": [
    {"key": "hydra-umc", "label": "HYDRA-UMC", "prefixes": ["HYDRA-UMC"]},
    {"key": "urtc", "label": "URTC", "prefixes": ["URTC"]},
    {"key": "armor", "label": "A.R.M.O.R.", "prefixes": ["ARMOR-"]},
    {"key": "eh3d", "label": "EH3D", "prefixes": ["EH3D-", "ELECTRO-HOBBY-3D-UPDATER"]}
  ],
  "exclude_repos": [".github", "JuanenRac"],
  "skip_forks": true,
  "skip_archived": true,
  "types": {
    "default": "tools",
    "order": ["firmware", "apps", "services", "tools", "docs"],
    "rules": [
      {"type": "docs", "match": ["*-DOCS", "*-DOCS-QA"]},
      {"type": "firmware", "match": ["ARMOR-NODE-*", "EH3D-NODE-*", "HYDRA-UMC", "URTC", "URTC-SMART-RACK"]},
      {
        "type": "apps",
        "match": [
          "*-ANDROID-CONTROL", "*-IOS-CONTROL", "*-WATCH", "*-DSI", "*-STUDIO", "*-STUDIO-KIT", "*-SUITE", "*-WEB-STUDIO", "*-FLASHER", "*-TESTER", "*-GUI",
          "*-EDITOR-*", "*-GERBERVIEWER", "*-DRILLPRO", "*-ROUTEPRO", "*-PHOENIX-*", "*-ISOCAM", "*-STENCILCAM", "*-AUTOLEVEL", "*-CAM-DEBUGGER",
          "*-VISION-STUDIO", "*-DESIGN-EXPLORER", "*-DASHBOARD-AI", "*-SUITE-LAUNCHER", "*-THERMAL-LAB", "*-VALIDATION-LAB", "*-VISION-TOOL"
        ]
      },
      {
        "type": "services",
        "match": [
          "*-SERVER", "*-SERVER-AI", "*-BRIDGE", "*-BRIDGE-*", "*-GATEWAY", "*-GATEWAY-*", "*-ORCHESTRATOR", "*-DATALAKE", "*-MQTT-BROKER", "*-JOB-DISPATCHER",
          "*-NODE-HEALING", "*-TELEMETRY-COLLECTOR", "*-OPCUA-SERVER", "*-MTCONNECT-ADAPTER", "*-CONNECTOR-HUB", "*-ANOMALY-DETECTOR", "*-COGNITIVE-NODE",
          "*-DEV-SERVER", "*-DEVELOPER-NODE", "*-LOCAL-TECHNICIAN", "*-OPS-AGENT", "*-PATH-PLANNER-3D", "*-PHYSICS-REPLICA", "*-PRODUCTION-REPORTS",
          "*-SAFETY-ZONES", "*-SEMANTIC-PLANNER", "*-SWARM-SYNC", "*-SYNTHETIC-DATA-GEN", "*-TWIN", "*-VISION-NODE", "*-VISION-STREAMER",
          "*-VISUAL-SERVOING-API", "*-VLA-ENGINE", "*-VOICE-UI", "*-VOICE-AI", "*-DETECTION-HEF", "*-VISION", "*-MESHES", "*-OS", "*-OS-REBUILDER",
          "*-SIMULATOR"
        ]
      }
    ]
  },
  "declared_tests": {"HYDRA-UMC-DOCS": "data/glance.json", "URTC-DOCS": "data/glance.json"},
  "exclude": {
    "dirs": [
      ".git", ".github", ".hg", ".svn", "node_modules", "bower_components", "vendor", "vendored", "third_party", "third-party", "thirdparty", "external",
      "deps", "dependencies", "managed_components", "components_external", "build", "builds", "dist", "out", "target", "obj", ".next", ".nuxt", ".gradle",
      ".idea", ".vscode", ".dart_tool", ".pio", ".cache", ".venv", "venv", "env", "__pycache__", ".pytest_cache", ".mypy_cache", ".tox", "site-packages",
      "Pods", "Carthage", "DerivedData", "coverage", "htmlcov", "sdkconfig.defaults.d", "playwright-report", "test-results", "snapshots", "__snapshots__",
      "pkg", "gen", "generated"
    ],
    "files": [
      "*.min.js", "*.min.css", "*.bundle.js", "*.map", "*.lock", "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "Cargo.lock", "poetry.lock",
      "Pipfile.lock", "Gemfile.lock", "composer.lock", "go.sum", "pubspec.lock", "Package.resolved", "gradlew", "gradlew.bat", "*.pb.go", "*_pb2.py",
      "*_pb2_grpc.py", "*.g.dart", "*.freezed.dart", "*.generated.*", "*.designer.cs", "sdkconfig", "sdkconfig.old", "LICENSE", "LICENSE.md",
      "LICENSE.txt", "COPYING", "NOTICE"
    ],
    "binary_extensions": [
      "png", "jpg", "jpeg", "gif", "bmp", "ico", "icns", "webp", "tif", "tiff", "svg", "svgz", "psd", "ai", "eps", "dxf", "dwg", "stl", "obj", "step",
      "stp", "3mf", "gbr", "drl", "kicad_pcb", "kicad_sch", "brd", "sch", "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "zip", "gz", "tgz", "xz",
      "bz2", "7z", "rar", "tar", "jar", "aar", "apk", "aab", "ipa", "exe", "dll", "so", "dylib", "a", "lib", "o", "obj", "bin", "elf", "hex", "uf2", "img",
      "iso", "wasm", "class", "pyc", "pyo", "ttf", "otf", "woff", "woff2", "eot", "mp3", "wav", "ogg", "flac", "mp4", "mov", "avi", "mkv", "webm", "onnx",
      "pt", "pth", "tflite", "hef", "npy", "npz", "pkl", "db", "sqlite", "sqlite3", "p12", "jks", "keystore", "pem", "der", "crt", "gcode", "nc", "qm",
      "mo"
    ],
    "max_file_bytes": 1500000,
    "max_line_chars": 4000
  },
  "tests": {
    "dirs": [
      "test", "tests", "__tests__", "e2e", "spec", "specs", "testing", "androidtest", "unittest", "unittests", "integration_test", "test_driver"
    ],
    "files": [
      "test_*", "*_test.*", "*_tests.*", "*.test.*", "*.spec.*", "*Test.kt", "*Tests.kt", "*Test.java", "*Tests.java", "*Tests.swift", "*Test.swift",
      "conftest.py"
    ]
  },
  "translations": {
    "dirs": ["i18n", "locales", "locale", "l10n", "translations", "lang", "languages"],
    "files": ["README_???.md", "README.??.md", "*.arb", "*.po", "*.pot", "*.strings", "*.xlf", "*.xliff", "strings.xml"],
    "extensions": ["json", "yaml", "yml", "toml", "properties", "xml", "ts", "js", "py", "qml", "arb", "po", "strings", "xlf"]
  },
  "docs": {
    "extensions": ["md", "markdown", "rst", "adoc", "txt"],
    "not_docs": ["requirements*.txt", "constraints*.txt", "CMakeLists.txt", "robots.txt", "*.cmake.txt", "CODEOWNERS"]
  },
  "changelog": {
    "max_versions": 30,
    "detail_versions": 5,
    "title_chars": 80,
    "text_chars": 200,
    "headings": {"added": "added", "new": "added", "changed": "changed", "deprecated": "changed", "removed": "changed", "fixed": "fix", "fix": "fix", "security": "security", "documentation": "docs", "docs": "docs", "tests": "tests", "performance": "performance"},
    "kinds": [
      {"key": "security", "keywords": ["security", "vulnerab", "cve-", "exploit", "secret", "credential", "leak", "injection", "xss", "csrf", "sanitiz", "harden", "traversal", "unauthori", "ignore-scripts"]},
      {"key": "fix", "keywords": ["fix", "bug", "regression", "crash", "broken", "incorrect", "wrong", "no longer", "failed", "fails", "failure", "corrected", "repair", "race", "hang", "freez", "panic", "overflow", "resolve", "stale", "mishandl", "misreport", "mistaken", "mismatch", "off-by-one", "instead of failing"], "patterns": ["\\b(?:used to|was not|were not|did not|had no)\\b"]},
      {"key": "performance", "keywords": ["performance", "faster", "speed", "latency", "cache", "memory use", "memory usage", "optimi", "throughput", "slow"]},
      {"key": "docs", "keywords": ["documentation", "docs", "readme", "changelog", "guide", "translation", "docstring", "manual", "help text", "wording", "typo"]},
      {"key": "tests", "keywords": ["test", "coverage", "fuzz", "e2e", "property-based", "sanitizer", "ctest", "assertion", "unit test", "pytest", "regression test"]},
      {"key": "refactor", "keywords": ["refactor", "clean up", "cleanup", "rename", "split", "extract", "simplif", "dead code", "dedup", "reorganiz", "restructur", "tidy", "consolidat", "rebuilt", "redesign", "reorder", "renamed", "shared code", "moved into"]},
      {"key": "maintenance", "keywords": ["build version", "synchronized with", "synchronised with", "synchronized package", "synchronised package", "incremental build", "package metadata", "pin the", "pinned to", "is pinned", "are pinned", "copies of the shared", "refreshed copy", "are refreshed", "copyright", "related projects", "project_catalog", "dependencies on", "not done", "not yet run", "code only in this release", "licence statement", "licence is written", "license is written", "maturity is"], "patterns": ["^(?:the )?(?:manifest|banner|licen[cs]e|maturity|sdk)\\b", "^(?:every|each) licen[cs]e", "^built with", "^refresh", "^pin\\b", "^version bump"]},
      {"key": "tooling", "keywords": ["workflow", "github actions", "build script", "dockerfile", "cargo.toml", "ci_validate", "check_all", "build.sh", "run.sh", "pyproject"], "patterns": ["\\bci\\b", "^(?:the )?(?:build|scripts?|linter|makefile)\\b"]},
      {"key": "added", "keywords": ["add", "new", "introduc", "implement", "support", "enable", "create", "provide", "can now", "feature", "first", "ship"], "patterns": ["^(?:an? |one |more |optional |new )", "^(?:the )?command line$", "^(?:also )?(?:gives|shows|lists|answers|accepts|emits|sends|carries|offers|exposes|gains|draws|opens|prints|lets|allows|writes|reads|holds|reports|returns|stores|saves|has|says|puts|makes|runs|builds|generates|produces|logs|names|adds)\\b", "^(?:write|read|show|list|send|draw|open|print|let|allow|give|make|extend|support)\\b", "^(?:the |an? )?.{2,70}? (?:can|may) (?:now |also )?(?:be|carry|say|show|name|have|take|use|read|write|send|open|print|list)\\b", "^(?:the |an? |each |every )?.{2,70}? (?:has|have|holds|carries|shows|says|lists|gives|counts|draws|names|accepts|answers|reads|writes|sends|offers|gains|uses|opens|reports|prints|publishes|puts|records|asks|keeps|tells|turns|lets|allows|makes|produces|generates)\\b"]},
      {"key": "changed", "keywords": ["chang", "update", "replace", "switch", "upgrade", "bump", "migrat", "now", "instead", "rework", "improv", "default", "deprecat", "remov", "drop", "move", "rewrite"], "patterns": ["^the .{2,80}? (?:is|are) (?:[a-z-]+ed|written|shown|kept|read|sent|drawn|made|taken|given|put|run|built|set|found|said)\\b", "^(?:stdout|anybody) "]}
    ]
  },
  "history": {"daily_days": 120, "weekly_days": 730, "max_points": 700},
  "clone": {"workers": 4, "timeout_seconds": 300}
}
