{
  "activity_days": { "green_max": 14, "amber_max": 30 },
  "release_days": { "green_max": 90, "amber_max": 180 },
  "alert_after_days": 30,
  "scaffolding_months": 6,
  "history_min_days": 7,
  "signature_alert": { "enabled": false, "after_days": 14 },
  "tests": {
    "sources": {
      "hydra-umc": { "glance": "HYDRA-UMC-DOCS/data/glance.json", "readme": true },
      "urtc": { "glance": "URTC-DOCS/data/glance.json", "readme": true },
      "armor": { "readme": true },
      "eh3d": { "readme": true },
      "electro-hobby-3d": { "readme": true }
    }
  },
  "actions": {
    "labels": { "failed": "build-failed", "stuck": "build-stuck" },
    "timeline_max": 40,
    "durations_max": 12,
    "ignore_paths": { "JuanenRac": [".github/workflows/build-dashboard.yml"] }
  },
  "ci_evidence": {
    "branch": "ci-evidence",
    "path": "ci-evidence.json",
    "default_branches": ["main"],
    "expire_days": { "host-test": 14, "simulator": 30, "bench": 180, "field": 365 }
  },
  "sentinel": {
    "enabled": true,
    "candidate_days": 2,
    "candidate_min_entries": 1,
    "skip_candidate_prefixes": ["EH3D-", "ELECTRO-HOBBY-3D"],
    "red_streak_warn": 2,
    "compute_warn_minutes_24h": 12000,
    "compute_top": 8,
    "ruleset_name": "protect-main",
    "read_actions_settings": true,
    "sections": { "ci": true, "releases": true, "signatures": true, "hygiene": true, "compute": true, "trend": true }
  }
}
