{
  "activity_days": { "green_max": 14, "amber_max": 30 },
  "release_days": { "green_max": 90, "amber_max": 180 },
  "alert_after_days": 30,
  "http_cache": { "enabled": true, "max_entries": 600, "max_body_bytes": 60000, "stale_max_hours": 72, "path": "data/etag-cache.json" },
  "scaffolding_months": 6,
  "history_min_days": 7,
  "signature_alert": { "enabled": false, "after_days": 14 },
  "presence": {
    "enabled": true,
    "attestations": true,
    "max_repos_per_run": 30,
    "api_budget": 120,
    "attestation_files_per_release": 3,
    "recheck_days": 3,
    "release_extensions": [".bin", ".tgz", ".tar.gz", ".gz", ".xz", ".zip", ".7z", ".apk", ".aab", ".whl", ".exe", ".msi", ".deb", ".img", ".jar"]
  },
  "tests": {
    "sources": {
      "hydra-umc": { "glance": "HYDRA-UMC-DOCS/data/glance.json", "readme": true },
      "urtc": { "glance": "URTC-DOCS/data/glance.json", "readme": true },
      "armor": { "readme": true },
      "eh3d": { "readme": true },
      "electro-hobby-3d": { "readme": true }
    }
  },
  "actions": {
    "labels": { "failed": "build-failed", "stuck": "build-stuck" },
    "timeline_max": 40,
    "durations_max": 12,
    "ignore_paths": { "JuanenRac": [".github/workflows/build-dashboard.yml"] }
  },
  "ci_evidence": {
    "branch": "ci-evidence",
    "path": "ci-evidence.json",
    "default_branches": ["main"],
    "expire_days": { "host-test": 14, "simulator": 30, "bench": 180, "field": 365 }
  },
  "sentinel": {
    "enabled": true,
    "candidate_days": 2,
    "candidate_min_entries": 2,
    "skip_candidate_prefixes": ["EH3D-", "ELECTRO-HOBBY-3D"],
    "red_streak_warn": 2,
    "compute_warn_minutes_24h": 12000,
    "compute_top": 6,
    "ruleset_name": "protect-main",
    "read_actions_settings": true,
    "events_max": 30,
    "sections": { "ci": true, "releases": true, "signatures": true, "hygiene": true, "compute": true, "trend": true, "ecosystems": true, "events": true }
  }
}
